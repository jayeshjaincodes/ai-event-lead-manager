# Database configuration (Neon PostgreSQL connection string)
DATABASE_URL=postgresql+asyncpg://neondb_owner:password@ep-sample-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require

# Google Gemini API Key (Backend-only)
GEMINI_API_KEY=your_gemini_api_key_here

# Allowed frontend origin for CORS
FRONTEND_URL=http://localhost:3000

# Server Environment
ENVIRONMENT=development
PORT=8000
HOST=0.0.0.0
