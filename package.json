{
  "name": "ai-event-lead-manager",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "(python3 -m uvicorn app.main:app --app-dir backend --host 127.0.0.1 --port 8001 &) && NODE_ENV=development next dev ./frontend -p 3000 -H 0.0.0.0",
    "build": "NODE_ENV=production next build ./frontend",
    "start": "(python3 -m uvicorn app.main:app --app-dir backend --host 127.0.0.1 --port 8001 &) && NODE_ENV=production next start ./frontend -p 3000 -H 0.0.0.0",
    "lint": "cd frontend && npx tsc --noEmit"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/postcss": "^4.3.3",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "next": "^16.3.8",
    "postcss": "^8.5.29",
    "react": "^19.0.1",
    "react-dom": "^19.0.1"
  },
  "devDependencies": {
    "@types/jsdom": "^30.0.0",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "jsdom": "^30.1.2",
    "puppeteer-core": "^25.12.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2"
  }
}
