# Gemini API Key (Backend only, never exposed to frontend)
GEMINI_API_KEY="your-gemini-api-key"

# PostgreSQL Database URL (Neon / PostgreSQL with asyncpg or psycopg)
DATABASE_URL="postgresql+asyncpg://user:password@ep-sample-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require"

# Backend CORS Allowed Frontend URL
FRONTEND_URL="http://localhost:3000"

# Frontend API base URL (defaults to http://localhost:8000 in dev)
NEXT_PUBLIC_API_BASE_URL="http://localhost:8000"

